# MongoDB Atlas connection string (include the database name, e.g. .../mijab?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mijab?retryWrites=true&w=majority

# Secret used to sign customer + admin JWTs — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed origins for CORS, e.g. https://mijab.com,https://www.mijab.com
# Use * to allow any origin (fine for early development)
CORS_ORIGIN=*

# Used only by scripts/seed.js to create the first admin account
ADMIN_NAME=MIJAB Admin
ADMIN_EMAIL=admin@mijab.com
ADMIN_PASSWORD=admin123

# Port for local dev server (local-server.js). Vercel ignores this.
PORT=4000
