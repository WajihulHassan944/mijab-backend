# MongoDB Atlas connection string (include the database name, e.g. .../mijab?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mijab?retryWrites=true&w=majority

# Secret used to sign customer + admin JWTs — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed origins for CORS, e.g. https://mijab.com,https://www.mijab.com
# Use * to allow any origin (fine for early development)
CORS_ORIGIN=*

# Used only by scripts/seed.js to create the first admin account
ADMIN_NAME=MIJAB Admin
ADMIN_EMAIL=admin@mijab.com
ADMIN_PASSWORD=admin123

# Port for local dev server (local-server.js). Vercel ignores this.
PORT=4000

# Pusher — realtime events (admin:new order/message, per-order status updates).
# Entirely optional: if unset, src/utils/pusher.js silently no-ops.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Brevo — transactional email (order confirmation, admin reply-to-customer).
# Entirely optional: if unset, src/utils/email.js silently no-ops.
# BREVO_SENDER_EMAIL must be a sender verified in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MIJAB

# Safepay — online card payments ("Express Checkout", hosted by Safepay so
# this server never touches card data). Required for the "Debit or credit
# card" checkout option to work; without it that option fails with a clear
# 503 rather than silently pretending to charge the customer.
# SAFEPAY_ENV must be "sandbox" or "production". SAFEPAY_WEBHOOK_SECRET is
# the *separate* signing secret from Safepay dashboard > Developers >
# Webhooks — not the same as SAFEPAY_SECRET_KEY — used to verify that a
# payment-outcome notification really came from Safepay.
SAFEPAY_ENV=sandbox
SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=

# Used to build the redirect_url/cancel_url Safepay sends the customer back
# to after paying (or cancelling), e.g. https://mijab.vercel.app
FRONTEND_URL=
